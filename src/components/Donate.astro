---
interface Props {
  text?: string;
}

const { text = "Yape" } = Astro.props;
---
<section class="flex flex-col items-center py-18">
  <div class="flex flex-col items-center gap-6">
    <div>
      <h1 class="font-extrabold text-4xl text-center">
        Your contribution is welcome
      </h1>
      <p class="text-sm text-gray-400 text-center">
        We appreciate your trust in our product, and your safety is our priority.
      </p>
    </div>
    <div>
      <button 
        id="open-donate-modal" 
        class="bg-[#00D4BB] text-[#2B004F] font-bold py-1 px-4 rounded-full shadow-lg transition-all duration-100 flex items-center gap-2 transform hover:scale-105 cursor-pointer"
      >
        <svg xmlns="http://w3.org" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        {text}
      </button>
    </div>
  </div>
</section>

<!-- modal -->
<div 
  id="donate-modal" 
  class="fixed inset-0 bg-black/70 backdrop-blur-sm items-center justify-center z-50 opacity-0 hidden transition-opacity duration-300"
>
  <div class="bg-[#2B004F] border border-[#00D4BB]/20 p-6 rounded-2xl max-w-sm w-full mx-4 text-center shadow-2xl relative">

    <button 
      id="close-donate-modal" 
      class="absolute top-4 right-4 text-slate-400 hover:text-white text-xl font-bold"
    >
      ✕
    </button>

    <h3 class="text-xl font-bold text-white mb-2">Thank you so much for your support!</h3>
    <p class="text-slate-300 text-sm mb-4">Scan the QR code from your Yape app to send your donation.</p>
    
    <!-- Imagen del QR de Yape -->
    <div class="bg-white p-4 rounded-xl inline-block mb-4 shadow-inner">
      <img 
        src="/src/assets/others/yape.png" 
        alt="Código QR de Yape para donaciones" 
        class="w-48 h-48 object-contain mx-auto"
      />
    </div>

    <p class="text-xs text-[#00D4BB] font-medium">Name: Derian Aaron Lomas A.</p>
  </div>
</div>

<script>
  // Logic to open and close the modal
  const openBtn = document.getElementById('open-donate-modal');
  const closeBtn = document.getElementById('close-donate-modal');
  const modal = document.getElementById('donate-modal');

  function openModal() {
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      // A little trick to make the opacity animation work
      setTimeout(() => modal.classList.remove('opacity-0'), 10);
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add('opacity-0');
      // We wait for the animation to finish to hide it completely
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }, 300);
    }
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  // Close also if they click outside the purple box
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>
