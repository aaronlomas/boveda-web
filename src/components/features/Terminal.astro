---
import LayoutTerminal from "./LayoutTerminal.astro";

const tabs = [
  { label: "Log", active: false },
  { label: "Terminal", active: true },
];
---

<!-- Terminal Commands Reference -->
<div class="mt-24">
  <div class="max-w-3xl mx-auto mb-12 text-center">
    <h3 class="text-2xl md:text-4xl font-bold text-white mb-4">
      Terminal Commands
    </h3>
    <p class="text-slate-400 text-base leading-relaxed text-start">
      The built-in terminal gives you direct access to vault diagnostics and
      audit tools. Type <code
        class="text-cyan-400 bg-slate-800 px-1.5 py-0.5 rounded font-mono text-sm"
        >help</code
      > inside Bóveda to see all available commands.
    </p>
  </div>

  <!-- Terminal window -->
  <div class="max-w-4xl mx-auto mb-8">
    <LayoutTerminal tabs={tabs} glowColor="rgba(34,211,238,0.15)">
      <div class="px-6 py-5 font-mono text-sm">
        <p class="text-slate-500 mb-2">Type 'help' for available commands.</p>
        <p class="text-cyan-400 mb-3">
          <span class="text-green-400">username@boveda-core</span><span
            class="text-slate-500">:~$</span
          > help
        </p>
        <div
          class="border border-slate-700/50 rounded-lg px-4 py-3 text-slate-300 space-y-1.5"
        >
          <p class="text-cyan-300 font-semibold mb-2">— boveda-core CLI —</p>
          <div class="grid grid-cols-[110px_1fr] gap-x-4 gap-y-1.5">
            <span class="text-yellow-300">crypto</span><span
              class="text-slate-400">Show active cryptographic parameters</span
            >
            <span class="text-yellow-300">status</span><span
              class="text-slate-400"
              >Show vault lock state and session info</span
            >
            <span class="text-yellow-300">audit</span><span
              class="text-slate-400">Show last 10 audit log entries</span
            >
            <span class="text-yellow-300">audit -n &lt;N&gt;</span><span
              class="text-slate-400">Show last N audit log entries</span
            >
            <span class="text-yellow-300">audit -rm</span><span
              class="text-slate-400">Clear all audit log entries</span
            >
            <span class="text-yellow-300">clear</span><span
              class="text-slate-400">Clear terminal output</span
            >
            <span class="text-yellow-300">help</span><span
              class="text-slate-400">Show this help message</span
            >
          </div>
        </div>
      </div>
    </LayoutTerminal>
  </div>

  <!-- Command Detail Cards -->
  <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-5">
    <!-- crypto -->
    <div
      class="group p-6 rounded-2xl border border-slate-800 bg-slate-900/40 hover:border-yellow-500/40 hover:bg-slate-900/70 hover:shadow-[0_0_25px_-8px_rgba(234,179,8,0.2)] transition-all duration-300 hover:-translate-y-0.5"
    >
      <div class="flex items-start gap-4">
        <div
          class="shrink-0 w-10 h-10 rounded-xl bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center"
        >
          <svg
            fill="none"
            stroke="currentColor"
            class="w-5 h-5 text-yellow-400"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 15v2m-6 4h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2m10-10V7a4 4 0 0 0-8 0v4z"
            ></path></svg
          >
        </div>
        <div>
          <code class="text-yellow-300 font-mono font-semibold text-base"
            >crypto</code
          >
          <p class="text-slate-400 text-sm mt-1.5 leading-relaxed">
            Displays the active <strong class="text-slate-300"
              >cryptographic parameters</strong
            > of the vault: the encryption algorithm in use, key derivation function,
            and any relevant cipher settings. Useful to verify your vault's security
            configuration at a glance.
          </p>
        </div>
      </div>
    </div>

    <!-- status -->
    <div
      class="group p-6 rounded-2xl border border-slate-800 bg-slate-900/40 hover:border-cyan-500/40 hover:bg-slate-900/70 hover:shadow-[0_0_25px_-8px_rgba(34,211,238,0.2)] transition-all duration-300 hover:-translate-y-0.5"
    >
      <div class="flex items-start gap-4">
        <div
          class="shrink-0 w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center"
        >
          <svg
            fill="none"
            stroke="currentColor"
            class="w-5 h-5 text-cyan-400"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m9 12 2 2 4-4m5.618-4.016A11.96 11.96 0 0 1 12 2.944a11.96 11.96 0 0 1-8.618 3.04A12 12 0 0 0 3 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016"
            ></path></svg
          >
        </div>
        <div>
          <code class="text-cyan-300 font-mono font-semibold text-base"
            >status</code
          >
          <p class="text-slate-400 text-sm mt-1.5 leading-relaxed">
            Shows the current <strong class="text-slate-300"
              >vault lock status</strong
            >, session information, and the path where the database is stored.
          </p>
        </div>
      </div>
    </div>

    <!-- audit -->
    <div
      class="group p-6 rounded-2xl border border-slate-800 bg-slate-900/40 hover:border-indigo-500/40 hover:bg-slate-900/70 hover:shadow-[0_0_25px_-8px_rgba(99,102,241,0.2)] transition-all duration-300 hover:-translate-y-0.5"
    >
      <div class="flex items-start gap-4">
        <div
          class="shrink-0 w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center"
        >
          <svg
            fill="none"
            stroke="currentColor"
            class="w-5 h-5 text-indigo-400"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 10h16M4 14h10M4 18h6"></path></svg
          >
        </div>
        <div>
          <code class="text-indigo-300 font-mono font-semibold text-base"
            >audit</code
          >
          <p class="text-slate-400 text-sm mt-1.5 leading-relaxed">
            Prints the <strong class="text-slate-300"
              >last 10 audit log entries</strong
            >, showing a timestamped record of vault events such as unlocks,
            account access, and configuration changes. Ideal for a quick
            security review.
          </p>
        </div>
      </div>
    </div>

    <!-- audit -n <N> -->
    <div
      class="group p-6 rounded-2xl border border-slate-800 bg-slate-900/40 hover:border-indigo-500/40 hover:bg-slate-900/70 hover:shadow-[0_0_25px_-8px_rgba(99,102,241,0.2)] transition-all duration-300 hover:-translate-y-0.5"
    >
      <div class="flex items-start gap-4">
        <div
          class="shrink-0 w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center"
        >
          <svg
            fill="none"
            stroke="currentColor"
            class="w-5 h-5 text-indigo-400"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 10h16M4 14h10M4 18h6"></path></svg
          >
        </div>
        <div>
          <code class="text-indigo-300 font-mono font-semibold text-base"
            >audit -n &lt;N&gt;</code
          >
          <p class="text-slate-400 text-sm mt-1.5 leading-relaxed">
            Shows the <strong class="text-slate-300"
              >last N audit log entries</strong
            >, where <code
              class="text-slate-300 bg-slate-800 px-1 rounded text-xs">N</code
            > is any positive integer you specify. For example, <code
              class="text-indigo-300 bg-slate-800 px-1 rounded text-xs font-mono"
              >audit -n 50</code
            > retrieves the 50 most recent events.
          </p>
        </div>
      </div>
    </div>

    <!-- audit -rm -->
    <div
      class="group p-6 rounded-2xl border border-slate-800 bg-slate-900/40 hover:border-red-500/40 hover:bg-slate-900/70 hover:shadow-[0_0_25px_-8px_rgba(239,68,68,0.2)] transition-all duration-300 hover:-translate-y-0.5"
    >
      <div class="flex items-start gap-4">
        <div
          class="shrink-0 w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center"
        >
          <svg
            fill="none"
            stroke="currentColor"
            class="w-5 h-5 text-red-400"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="m19 7-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16"
            ></path></svg
          >
        </div>
        <div>
          <code class="text-red-300 font-mono font-semibold text-base"
            >audit -rm</code
          >
          <p class="text-slate-400 text-sm mt-1.5 leading-relaxed">
            <strong class="text-red-400">Permanently clears</strong> all stored audit
            log entries. Use with caution — this action is irreversible and will erase
            the full history of vault events.
          </p>
        </div>
      </div>
    </div>

    <!-- clear & help -->
    <div class="grid grid-rows-2 gap-5">
      <!-- clear -->
      <div
        class="group p-5 rounded-2xl border border-slate-800 bg-slate-900/40 hover:border-slate-600/60 hover:bg-slate-900/70 transition-all duration-300 hover:-translate-y-0.5 flex items-start gap-4"
      >
        <div
          class="shrink-0 w-10 h-10 rounded-xl bg-slate-700/40 border border-slate-700 flex items-center justify-center"
        >
          <svg
            fill="none"
            stroke="currentColor"
            class="w-5 h-5 text-slate-400"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18 18 6M6 6l12 12"></path></svg
          >
        </div>
        <div>
          <code class="text-slate-300 font-mono font-semibold text-base"
            >clear</code
          >
          <p class="text-slate-400 text-sm mt-1 leading-relaxed">
            Clears all visible text from the terminal output, giving you a clean
            workspace without affecting logs or session data.
          </p>
        </div>
      </div>
      <!-- help -->
      <div
        class="group p-5 rounded-2xl border border-slate-800 bg-slate-900/40 hover:border-slate-600/60 hover:bg-slate-900/70 transition-all duration-300 hover:-translate-y-0.5 flex items-start gap-4"
      >
        <div
          class="shrink-0 w-10 h-10 rounded-xl bg-slate-700/40 border border-slate-700 flex items-center justify-center"
        >
          <svg
            fill="none"
            stroke="currentColor"
            class="w-5 h-5 text-slate-400"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0"
            ></path></svg
          >
        </div>
        <div>
          <code class="text-slate-300 font-mono font-semibold text-base"
            >help</code
          >
          <p class="text-slate-400 text-sm mt-1 leading-relaxed">
            Displays the full list of available commands directly in the
            terminal, as shown above.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- End Terminal Commands Reference -->
