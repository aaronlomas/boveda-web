---
import { marked } from "marked";

const GITHUB_RAW_URL =
  "https://raw.githubusercontent.com/aaronlomas/boveda/refs/heads/main/PRIVACY.md";

let githubContentHtml = "";

try {
  const response = await fetch(GITHUB_RAW_URL);
  if (!response.ok) throw new Error("No se pudo obtener el archivo de GitHub");

  const markdownTexto = await response.text();

  githubContentHtml = await marked.parse(markdownTexto);
} catch (error) {
  console.error("Error al cargar la privacidad desde GitHub:", error);
  githubContentHtml =
    "<p>Error al cargar las especificaciones técnicas. Por favor, verifica el repositorio oficial.</p>";
}
---

<main class="flex justify-center p-12">
  <section class="prose prose-slate dark:prose-invert">
    <div set:html={githubContentHtml} />
  </section>
</main>
