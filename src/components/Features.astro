---
const features = [
  {
    title: "Visual Log",
    description: "Acts as a monitoring interface for regular technical events.",
    icon: `<svg fill="none" stroke="currentColor" class="w-6 h-6 text-indigo-400" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7s-8.268-2.943-9.542-7"/></svg>`,
  },
  {
    title: "Terminal",
    description:
      "It contains essential functions designed to improve and facilitate vault auditing.",
    icon: `<svg fill="none" stroke="currentColor" class="w-6 h-6 text-cyan-400" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 9 3 3-3 3m5 0h3M5 20h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2"/></svg>`,
  },
];
---

<section
  id="features"
  class="relative flex flex-col justify-center"
>
  <div class="max-w-7xl mx-auto">
    <div class="max-w-3xl mx-auto mb-16">
      <h2
        class="text-3xl md:text-5xl font-bold text-white mb-6 [text-shadow:0_0_15px_#ffffff7a] text-center"
      >
        Latest Features
      </h2>
      <p class="text-lg">
        The latest implementations aim to transparently display the parameters
        and configurations of <strong>Bóveda Core</strong>
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {
        features.map((feature) => (
          <div class="p-8 rounded-3xl border border-slate-800 hover:border-indigo-500/50 transition-all duration-300 hover:shadow-[0_0_30px_-10px_rgba(79,70,229,0.3)] hover:-translate-y-1 group">
            <div
              class="w-14 h-14 rounded-2xl bg-slate-800/80 border border-slate-700 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-slate-800 transition-all shadow-inner"
              set:html={feature.icon}
            />
            <h3 class="text-xl font-semibold text-white mb-3 tracking-tight">
              {feature.title}
            </h3>
            <p class="text-slate-400 leading-relaxed text-sm md:text-base">
              {feature.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
