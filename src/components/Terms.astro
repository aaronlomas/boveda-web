---
import { marked } from "marked";

const GITHUB_RAW_URL =
  "https://raw.githubusercontent.com/aaronlomas/boveda/refs/heads/main/TERMS.md";

let githubContentHtml = "";

try {
  const response = await fetch(GITHUB_RAW_URL);
  if (!response.ok) throw new Error("Could not get the file");

  const markdownTexto = await response.text();

  githubContentHtml = await marked.parse(markdownTexto);
} catch (error) {
  console.error("Error loading terms:", error);
  githubContentHtml =
    "<p>Error loading terms and conditions. Please, check the official repository.</p>";
}
---

<main class="flex justify-center p-12">
  <section class="prose prose-slate dark:prose-invert">
    <div set:html={githubContentHtml} />
  </section>
</main>