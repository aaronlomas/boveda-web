---
import linuxIconSvg from "../assets/linux-clean.svg?raw";
// Fetch the latest release from GitHub API at build time
interface GitHubAsset {
  name: string;
  browser_download_url: string;
}

let assets: GitHubAsset[] = [];
let releaseVersion = "v1.1.0";
let releaseUrl = "https://github.com/aaronlomas/boveda/releases/latest";

try {
  const response = await fetch(
    "https://api.github.com/repos/aaronlomas/boveda/releases/latest",
    {
      headers: {
        Accept: "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
      },
    }
  );
  if (response.ok) {
    const data: { assets: GitHubAsset[]; tag_name: string; html_url: string } =
      await response.json();
    assets = data.assets ?? [];
    releaseVersion = data.tag_name ?? releaseVersion;
    releaseUrl = data.html_url ?? releaseUrl;
  }
} catch (e) {
  // Fallback to static links if fetch fails
}

// Map assets to platform categories
const platformMap = [
  {
    id: "windows",
    label: "Windows",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/></svg>`,
    formats: [
      {
        ext: ".exe",
        label: "Installer (.exe)",
        pattern: /setup\.exe$/i,
        color: "blue",
      },
      {
        ext: ".msi",
        label: "MSI Package",
        pattern: /\.msi$/i,
        color: "blue",
      },
    ],
  },
  {
    id: "linux",
    label: "Linux",
    icon: linuxIconSvg,
    formats: [
      { ext: ".deb", label: "Debian / Ubuntu (.deb)", pattern: /\.deb$/i, color: "orange" },
      { ext: ".rpm", label: "Fedora / RHEL (.rpm)", pattern: /\.rpm$/i, color: "orange" },
      { ext: ".AppImage", label: "AppImage (Universal)", pattern: /\.AppImage$/i, color: "orange" },
    ],
  },
];

// Resolve download URLs from fetched assets or fallback to latest redirect
function getAssetUrl(pattern: RegExp): string {
  const asset = assets.find((a) => pattern.test(a.name));
  if (asset) return asset.browser_download_url;
  // Fallback to release page
  return releaseUrl;
}
---

<section id="download" class="relative overflow-hidden min-h-[90vh] flex flex-col justify-center">
  <!-- Background glow -->
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    aria-hidden="true"
  >
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-100 h-100 bg-indigo-700/15 rounded-full blur-[100px]"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-300 text-sm font-medium mb-6"
      >
        <span class="flex h-2 w-2 rounded-full bg-green-400 animate-pulse"
        ></span>
        Latest Release — {releaseVersion}
      </div>
      <h2
        class="text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4"
      >
        Download
      </h2>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto">
        Free and open source. Available for Windows and Linux. Your vault,
        your rules.
      </p>
    </div>

    <!-- Platform Cards -->
    <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {
        platformMap.map((platform) => (
          <div class="download-card group relative rounded-2xl border border-slate-700/60 bg-slate-900/60 backdrop-blur-sm p-8 hover:border-indigo-500/50 transition-all duration-300 hover:shadow-[0_0_40px_-10px_rgba(99,102,241,0.4)]">
            <!-- Platform icon + label -->
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 rounded-xl bg-slate-800 flex items-center justify-center text-slate-300 group-hover:text-indigo-300 transition-colors duration-300">
                <span class="w-7 h-7 block" set:html={platform.icon} />
              </div>
              <div>
                <h3 class="text-xl font-bold text-white">{platform.label}</h3>
                <p class="text-slate-400 text-sm">{releaseVersion}</p>
              </div>
            </div>

            <!-- Format buttons -->
            <div class="flex flex-col gap-3">
              {platform.formats.map((fmt) => {
                const url = getAssetUrl(fmt.pattern);
                return (
                  <a
                    href={url}
                    class={`download-btn flex items-center justify-between px-4 py-3 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/50 hover:border-indigo-500/40 text-slate-300 hover:text-white transition-all duration-200 group/btn`}
                    download
                    target={url === releaseUrl ? "_blank" : undefined}
                    rel="noopener noreferrer"
                  >
                    <div class="flex items-center gap-3">
                      <!-- Download icon -->
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-indigo-400 group-hover/btn:text-indigo-300 shrink-0">
                        <path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z" />
                        <path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z" />
                      </svg>
                      <span class="font-medium text-sm">{fmt.label}</span>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-3.5 h-3.5 text-slate-500 group-hover/btn:text-slate-300 group-hover/btn:translate-x-0.5 transition-transform duration-200 shrink-0">
                      <path fill-rule="evenodd" d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                    </svg>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>

    <!-- View all releases link -->
    <div class="text-center mt-10">
      <a
        href={releaseUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-slate-400 hover:text-indigo-300 text-sm font-medium transition-colors duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
          <path d="M10 1a9 9 0 1 0 0 18A9 9 0 0 0 10 1Zm0 6.5a.75.75 0 0 1 .75.75v3.19l1.47-1.47a.75.75 0 1 1 1.06 1.06l-2.75 2.75a.75.75 0 0 1-1.06 0l-2.75-2.75a.75.75 0 1 1 1.06-1.06L9.25 11.44V8.25A.75.75 0 0 1 10 7.5Z" />
        </svg>
        View all releases on GitHub
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-3 h-3">
          <path fill-rule="evenodd" d="M4.22 11.78a.75.75 0 0 1 0-1.06L9.44 5.5H5.75a.75.75 0 0 1 0-1.5h5.5a.75.75 0 0 1 .75.75v5.5a.75.75 0 0 1-1.5 0V6.56l-5.22 5.22a.75.75 0 0 1-1.06 0Z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</section>

<section class="pb-20">
<div class="max-w-2xl mx-auto rounded-2xl">
  <h1 class="text-white font-extrabold text-4xl mb-4 text-center gap-2">
    Installation for Debian/Ubuntu
  </h1>
  <p class="text-slate-400 text-sm mb-6">
    Run these commands in your terminal to properly install Bóveda.
  </p>

  <div class="space-y-6 text-left selection:bg-slate-900">
    <!-- Step 1 -->
    <div>
      <span class="text-xs font-semibold uppercase tracking-wider text-orange-400 block mb-2">Step 1: Download the public GPG key</span>
      <div class="relative bg-slate-800 border border-indigo-500/20 p-4 font-mono text-xs text-slate-300 overflow-x-auto">
        <code>curl -fsSL https://aaronlomas.github.io/boveda/boveda-archive-keyring.gpg | sudo gpg --dearmor -o /usr/share/keyrings/boveda-archive-keyring.gpg</code>
      </div>
    </div>

    <!-- Step 2 -->
    <div>
      <span class="text-xs font-semibold uppercase tracking-wider text-orange-400 block mb-2">Step 2: Add the repository to APT sources</span>
      <div class="relative bg-slate-800 border border-indigo-500/20 p-4 font-mono text-xs text-slate-300 overflow-x-auto">
        <code>echo "deb [arch=amd64 signed-by=/usr/share/keyrings/boveda-archive-keyring.gpg] https://aaronlomas.github.io/boveda stable main" | sudo tee /etc/apt/sources.list.d/boveda.list > /dev/null</code>
      </div>
    </div>

    <!-- Step 3 -->
    <div>
      <span class="text-xs font-semibold uppercase tracking-wider text-orange-400 block mb-2">Step 3: Synchronize and install Bóveda</span>
      <div class="relative bg-slate-800 border border-indigo-500/20 p-4 font-mono text-xs text-slate-300 overflow-x-auto">
        <code>sudo apt update && sudo apt install boveda</code>
      </div>
    </div>
  </div>

</div>

</section>

<script>
  // Smart OS detection: highlight the recommended download for the user's platform
  const ua = navigator.userAgent.toLowerCase();
  const isWindows = ua.includes("win");
  const isLinux = ua.includes("linux") && !ua.includes("android");

  if (isWindows || isLinux) {
    const platformId = isWindows ? "windows" : "linux";
    // Find all download cards
    const cards = document.querySelectorAll(".download-card");
    cards.forEach((card, i) => {
      const platforms = ["windows", "linux"];
      if (platforms[i] === platformId) {
        card.classList.add("ring-2", "ring-indigo-500/50");
        // Add "Recommended for you" badge
        const badge = document.createElement("div");
        badge.className =
          "absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-indigo-600 text-white text-xs font-semibold whitespace-nowrap shadow-lg";
        badge.textContent = "✓ Recommended for you";
        card.appendChild(badge);
      }
    });
  }
</script>
